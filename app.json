{
  "expo": {
    "name": "Tattoo Masters",
    "slug": "Tattoo-Masters",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon-new.png",
    "scheme": "myapp",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ddjn.tattoomasters",
      "associatedDomains": ["applinks:tattoomasters.app"],
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "LSMinimumSystemVersion": "12.0.0",
        "ITSAppUsesNonExemptEncryption": false,
        "aps-environment": "production",
        "NSCameraUsageDescription": "Tattoo Masters uses your camera so you can take and send photos in chats.",
        "NSPhotoLibraryUsageDescription": "Tattoo Masters uses your photo library so you can choose images for profiles, tattoo posts, reviews, and chats.",
        "UIDesignRequiresCompatibility": true,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "LSApplicationQueriesSchemes": ["tel"]
      },
      "appleTeamId": "UR4D67257L"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.ddjn.tattoomasters",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tattoomasters.app",
              "pathPrefix": "/artist"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tattoomasters.app",
              "pathPrefix": "/tattoo"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugin/with-facebook-fbsdk-next.js",
      "./plugin/with-facebook-fbsdk-next-ios.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "android": {
            "imageWidth": 192
          },
          "ios": {
            "enableFullScreenImage_legacy": true
          }
        }
      ],
      [
        "react-native-maps-expo-plugin",
        {
          "googleMapsApiKey": "AIzaSyDsBQLKDuWUVnjHyTQKG1nZI6d0NiSqg-c"
        }
      ],
      [
        "./plugin/with-google-maps-android.js",
        {
          "googleMapsApiKey": "AIzaSyDsBQLKDuWUVnjHyTQKG1nZI6d0NiSqg-c"
        }
      ],
      "./plugin/with-android-legacy-back.js",
      [
        "expo-dev-launcher",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.828691216515-n0t5t1ifeo19pio4f01chppf42k73639"
        }
      ],
      "expo-apple-authentication",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tattoo Masters uses your location to find nearby artists and studios—for example, within your selected search radius.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "./plugin/without-ios-user-tracking.js",
      "./plugin/with-min-pod-deployment-target.js",
      "./plugin/with-ios-scene-delegate.js",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "da0d9a9a-44d0-4288-ae49-ecd8016d3077"
      }
    }
  }
}
