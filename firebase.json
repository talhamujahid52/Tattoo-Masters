      ]
    },
    {
      "source": "kits/firestore-typesense-search",
      "codebase": "typesense-search",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    },
    {
      "source": "kits/delete-user-data",
      "codebase": "delete-user-data",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
