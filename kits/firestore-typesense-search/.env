# Merged from the two installed extension instances "firestore-typesense-search-users"
# (Users) and "firestore-typesense-search" (publications), both
# typesense/firestore-typesense-search@2.1.0, exported on 2026-10-07 with `firebase ext:export`.
# TYPESENSE_API_KEY is a Secret Manager secret, not set here:
#   firebase functions:secrets:set TYPESENSE_API_KEY
LOCATION=europe-north1
FIRESTORE_DATABASE_REGION=europe-north1
DATABASE='(default)'
FIRESTORE_COLLECTION_PATHS=Users,publications
TYPESENSE_COLLECTION_NAMES=Users,publications
FIRESTORE_COLLECTION_FIELDS_LIST=
FLATTEN_NESTED_DOCUMENTS_LIST=false,false
TYPESENSE_HOSTS=wi0ecngpr2q43hz9p-1.a1.typesense.net
LOG_TYPESENSE_INSERTS=false
