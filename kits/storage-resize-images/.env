# Exported from the installed extension instance "storage-resize-images"
# (firebase/storage-resize-images@0.3.6) on 2026-10-07 with `firebase ext:export`.
LOCATION=europe-west1
IMG_BUCKET=tattoo-masters-48277.firebasestorage.app
IMG_SIZES=400x400,1080x1920,1440x2560,720x1280
IMAGE_TYPE=jpeg
DELETE_ORIGINAL_FILE=on_success
MAKE_PUBLIC=true
REGENERATE_TOKEN=false
IS_ANIMATED=true
FUNCTION_MEMORY=1024
CONTENT_FILTER_LEVEL=OFF
# The extension's value was missing a comma (invalid JSON), so sharp's default
# jpeg quality (80) was silently used. Fixed here, so resized images are now
# written at quality 92 with 4:4:4 chroma subsampling.
OUTPUT_OPTIONS='{"jpeg": {"quality": 92, "chromaSubsampling": "4:4:4"}}'
