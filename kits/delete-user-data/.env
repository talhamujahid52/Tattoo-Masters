# Exported from the installed extension instance "delete-user-data"
# (firebase/delete-user-data@0.1.30) on 2026-10-07 with `firebase ext:export`.
LOCATION=us-central1
FIRESTORE_DATABASE_ID='(default)'
FIRESTORE_PATHS='Users/{UID}'
FIRESTORE_DELETE_MODE=shallow
CLOUD_STORAGE_BUCKET=tattoo-masters-48277.firebasestorage.app
ENABLE_AUTO_DISCOVERY=no
AUTO_DISCOVERY_SEARCH_DEPTH=3
AUTO_DISCOVERY_SEARCH_FIELDS=id,uid,userId
SELECTED_DATABASE_LOCATION=us-central1
# Pub/Sub topics are named <TOPIC_PREFIX>-discovery / -deletion (extension used ext-<id>-...).
TOPIC_PREFIX=delete-user-data
